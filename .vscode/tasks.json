{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Small APK (ARM64 ~7.5MB)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--target-platform",
        "android-arm64"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Split APKs (per ABI ~7.5MB)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--split-per-abi"
      ],
      "problemMatcher": []
    }
  ]
}
